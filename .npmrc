# Never resolve a package version published less than a week ago (Oct 22 2026).
# Every npm worm this year was caught and pulled within days, so a fresh
# resolution waits them out. npm ci from the lockfile is not affected (measured
# the same night): this guards new resolutions, npm install and npm update.
# To take one package sooner, add min-release-age-exclude=<name>.
min-release-age=7
# min-release-age needs npm 11 (Node 24 ships it); npm 10 ignores the line
# silently, so on npm 10 only the lockfile protects you.

# onnxruntime-node runs the embedding model on the CPU. Its install step would
# otherwise download the CUDA build on Linux, and fail the install where that
# download is blocked. npm 11 prints an "Unknown project config" warning for
# this line; it still reaches the install step, and the warning is harmless.
onnxruntime-node-install=skip
